  {
    "id": "fn_store_context_v2",
    "type": "function",
    "z": "tab_gesture_led_v2",
    "name": "Mémoriser État Global",
    "func": "const state = (msg.payload || \"\").trim().toUpperCase();\nconst now = new Date();\nconst entry = {\n    state: state,\n    time: now.toLocaleTimeString(\"fr-FR\"),\n    date: now.toLocaleDateString(\"fr-FR\"),\n    timestamp: now.getTime()\n};\n\nglobal.set(\"lastLedState\", state);\nglobal.set(\"lastLedTime\", entry.time);\n\nlet history = global.get(\"ledHistory\") || [];\nhistory.unshift(entry);\nif (history.length > 20) {\n    history = history.slice(0, 20);\n}\nglobal.set(\"ledHistory\", history);\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "global.set(\"lastLedState\", \"OFF\");\nglobal.set(\"lastLedTime\", \"--:--:--\");\nglobal.set(\"ledHistory\", []);",
    "finalize": "",
    "libs": [],
    "x": 450,
    "y": 220,
    "wires": [[]]
  },
