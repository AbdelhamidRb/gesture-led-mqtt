  {
    "id": "fn_process_status_v2",
    "type": "function",
    "z": "tab_gesture_led_v2",
    "name": "Traitement Logique Métier",
    "func": "const state = (msg.payload || \"\").trim().toUpperCase();\nconst now = new Date();\nconst timeStr = now.toLocaleTimeString(\"fr-FR\");\n\nif (state === \"ON\") {\n    node.status({ fill: \"green\", shape: \"dot\", text: \"LED ALLUMÉE (ON) - \" + timeStr });\n    msg.ledState = \"ON\";\n    msg.isAccessGranted = true;\n    msg.color = \"#00E646\";\n    msg.badgeText = \"ACCÈS AUTORISÉ\";\n} else {\n    node.status({ fill: \"red\", shape: \"ring\", text: \"LED ÉTEINTE (OFF) - \" + timeStr });\n    msg.ledState = \"OFF\";\n    msg.isAccessGranted = false;\n    msg.color = \"#F03232\";\n    msg.badgeText = \"ACCÈS VERROUILLÉ\";\n}\n\nmsg.timestamp = now.toISOString();\nmsg.timeStr = timeStr;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 460,
    "y": 140,
    "wires": [
      [
        "debug_formatted_output_v2"
      ]
    ]
  },
